#!/bin/sh
# Pull-based deploys: make every app in /srv/deployments/<host>/ match git + the registry.
# Runs every minute from deploy-sync.timer. See README.md.
set -u
HOST=$(hostname)
DEPL=/srv/deployments
NTFY_URL=${NTFY_URL:-}
AGE_KEY=/etc/deploy-sync/age.key          # this host's age identity (install.sh creates it)
HEALTH_WAIT=${HEALTH_WAIT:-90}            # seconds to wait for healthchecks after up -d
[ -f /etc/default/deploy-sync ] && . /etc/default/deploy-sync

notify() { [ -n "$NTFY_URL" ] && curl -fsS -m 10 -d "$1" "$NTFY_URL" >/dev/null 2>&1; logger -t deploy-sync "$1"; }

# Traefik only routes to containers whose healthcheck is "healthy", so a container that comes up
# unhealthy means a 404 for visitors while compose considers the deploy done. Wait for every
# container of the app; notify once when something stays bad, once more when it recovers.
check_health() {
  dir=$1; app=$2; envf=$3; relf=$4; prev=$5
  mark="/srv/apps/$app/.unhealthy"
  waited=0
  while :; do
    bad=$(cd "$dir" && docker compose --env-file "$envf" --env-file "$relf" -p "$app" ps -aq 2>/dev/null |
          xargs -r docker inspect -f '{{.Name}} {{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}}' 2>/dev/null |
          awk '$2 != "running" || $3 == "unhealthy" || $3 == "starting" { print substr($1, 2) " " $2 "/" $3 }' | tr '\n' ' ')
    [ -z "$bad" ] && break
    [ "$waited" -ge "$HEALTH_WAIT" ] && break
    sleep 5; waited=$((waited + 5))
  done
  if [ -n "$bad" ]; then
    [ "$(cat "$mark" 2>/dev/null)" = "$bad" ] && return
    printf '%s' "$bad" > "$mark"
    notify "$app on $HOST unhealthy after deploy: $bad(previous release ${prev:-unknown}; rollback: deploy workflow with promote=${prev:-<tag>}, or pin it in deployments)"
  elif [ -f "$mark" ]; then
    rm -f "$mark"
    notify "$app on $HOST healthy again"
  fi
}

exec 9>/run/deploy-sync.lock
flock -n 9 || exit 0

cd "$DEPL" && git pull -q --ff-only || { notify "deploy-sync on $HOST: git pull failed"; exit 1; }
docker network inspect proxy >/dev/null 2>&1 || docker network create proxy >/dev/null

for dir in "$DEPL/$HOST"/*/; do
  [ -f "$dir/compose.yml" ] || continue
  app=$(basename "$dir")
  envf="/srv/apps/$app/.env"
  [ -f "$envf" ] || { mkdir -p "/srv/apps/$app" && install -m 600 /dev/null "$envf"; }
  # Secrets from git (env-sync.yml): <host>/<app>/.env.age, encrypted to this host's key.
  # When present it owns the .env; a broken file keeps the last good .env and notifies once.
  if [ -f "$dir/.env.age" ]; then
    mark="/srv/apps/$app/.env.age.failed"
    if ( umask 077 && age -d -i "$AGE_KEY" -o "$envf.new" "$dir/.env.age" ) 2>/dev/null; then
      rm -f "$mark"
      if cmp -s "$envf.new" "$envf"; then rm -f "$envf.new"
      else mv "$envf.new" "$envf" && notify "$app: .env updated on $HOST"; fi
    else
      rm -f "$envf.new"
      sum=$(sha256sum "$dir/.env.age" | cut -c1-64)
      [ "$(cat "$mark" 2>/dev/null)" = "$sum" ] || { echo "$sum" > "$mark"; notify "$app on $HOST: .env.age does not decrypt with $AGE_KEY, keeping the old .env"; }
    fi
  fi
  relf="/srv/apps/$app/release.env"
  prev_release=$(grep '^APP_RELEASE=' "$relf" 2>/dev/null | cut -d= -f2)
  before=$(cd "$dir" && docker compose --env-file "$envf" $( [ -f "$relf" ] && echo --env-file "$relf" ) -p "$app" images -q 2>/dev/null | sort | tr '\n' ' ')
  if ( cd "$dir" &&
       docker compose --env-file "$envf" -p "$app" pull -q &&
       { /usr/local/bin/deploy-release "$dir" "$envf" > "$relf.new" 2>/dev/null || true; } &&
       mv "$relf.new" "$relf" &&
       docker compose --env-file "$envf" --env-file "$relf" -p "$app" up -d --remove-orphans --quiet-pull ) >/tmp/deploy-sync.$app.log 2>&1
  then
    after=$(cd "$dir" && docker compose --env-file "$envf" $( [ -f "$relf" ] && echo --env-file "$relf" ) -p "$app" images -q 2>/dev/null | sort | tr '\n' ' ')
    [ "$before" != "$after" ] && notify "$app updated on $HOST ($(grep '^APP_RELEASE=' "$relf" | cut -d= -f2))"
    check_health "$dir" "$app" "$envf" "$relf" "$prev_release"
  else
    notify "deploy of $app on $HOST failed: $(tail -n 3 /tmp/deploy-sync.$app.log | tr '\n' ' ')"
  fi
done
docker image prune -f >/dev/null 2>&1
exit 0
